print("*** Ejercicio 14 Costo de envío (Versión personalizada) ***")

# float() convierte a número con decimales, porque el dinero y los km pueden tener decimales
pedido = float(input("\n¿Cuál es el monto total de tu pedido? $"))
# Si el usuario escribe 250, ahora pedido vale 250.0
distancia = float(input("¿A cuántos kilómetros te encuentras de la sucursal? "))
# Si el usuario escribe 8, ahora distancia vale 8.0

# En cada opción GUARDAMOS el costo de envío en la misma variable
# ¿8.0 es menor o igual que 3? False, pasa a la siguiente
if distancia <= 3:
    costo_envio = 0
    print("\n¡Felicidades, tu entrega es totalmente gratis!")

# ¿8.0 es menor o igual que 10? True, guarda 39 y TERMINA
elif distancia <= 10:
    costo_envio = 39
    print("\nEl costo por envío estándar es de $39")

elif distancia <= 20:
    costo_envio = 69
    print("\nEl costo de envío a distancia moderada es de $69")

# else: vive a más de 20 km
else:
    costo_envio = 0
    print("\nLo sentimos, no realizamos entregas a más de 20 km, te invitamos a recoger tu pedido en tienda")

# Esta parte no tiene sangría, se hace SIEMPRE
# Ahora costo_envio vale 39, esta fórmula dice: total = 250.0 + 39
total = pedido + costo_envio
print(f"Subtotal del pedido: ${pedido:.2f}")
print(f"Costo del envío: ${costo_envio:.2f}")
print(f"MONTO TOTAL A PAGAR: ${total:.2f}")