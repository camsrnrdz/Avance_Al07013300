print("*** Ejercicio 15 Rango en tu videojuego (Versión personalizada) ***")

# int() convierte el texto a número entero para poder comparar y hacer cuentas
puntos = int(input("\n¿Cuántos puntos de experiencia tienes? "))
# Si el usuario escribe 2500, ahora puntos vale 2500

print("\n===== TU RANGO ACTUAL EN EL JUEGO =====")

# Empezamos por el rango MÁS ALTO
# ¿2500 es mayor o igual que 3000? False, pasa a la siguiente
if puntos >= 3000:
    print("Rango: DIAMANTE")
    print("¡Impresionante, ya alcanzaste la cima absoluta!")

# ¿2500 es mayor o igual que 2000? True, entra aquí y TERMINA
elif puntos >= 2000:
    # Esta fórmula dice: faltan = 3000 - 2500
    faltan = 3000 - puntos
    # Ahora faltan vale 500
    print("Rango: ORO")
    print(f"Te faltan {faltan} puntos para subir a Diamante")

elif puntos >= 1000:
    faltan = 2000 - puntos
    print("Rango: PLATA")
    print(f"Te faltan {faltan} puntos para subir a Oro")

# else: tiene menos de 1000
else:
    faltan = 1000 - puntos
    print("Rango: BRONCE")
    print(f"Te faltan {faltan} puntos para subir a Plata")