print("*** Ejercicio 11 ¿Qué me pongo hoy? (Versión personalizada) ***")

# int() convierte el texto a número entero para poder comparar
temperatura = int(input("\n¿Cuántos grados marca el termómetro hoy? "))
# Si el usuario escribe 15, ahora temperatura vale 15

print("\n===== OUTFIT IDEAL DEL DÍAS =====")

# PREGUNTA 1: ¿Es menor que 10 grados?
if temperatura < 10:
    print("Temperatura baja: ponte abrigo pesado, bufanda y guantes")

# PREGUNTA 2: ya sabemos que hace 10 o más, ¿es menor que 20?
elif temperatura < 20:
    print("Clima fresco: sudadera ligera y pantalón largo")

# PREGUNTA 3: ya sabemos que hace 20 o más, ¿es menor que 30?
elif temperatura < 30:
    print("Clima agradable: playera cómoda y tenis")

# else: hace 30 o más grados
else:
    print("Calor intenso: ropa fresca, lentes de sol y mantente hidratado")