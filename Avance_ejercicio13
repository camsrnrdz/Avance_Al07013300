elif calificacion >= 80:
    print("¡Muy buen trabajo, excelente desempeño!")

# Ya sabemos que es menor que 80
elif calificacion >= 70:
    print("Aprobado con lo justo, a seguir esforzándose")

# else: es menor que 70
else:
    print("No acreditado, toca repasar los temas y volver a intentar")